# ref-clips site block for the shared edge proxy (github.com/fkula5/vps-edge). Not read by Caddy as is:
# deploy/render-site.sh substitutes the two placeholders below from .env and install-site.sh puts the
# result in /opt/edge/conf/sites/ (docs/wdrozenie.md). Global options live in the edge Caddyfile.
#
# REFCLIPS_SITE: the host this block serves (e.g. refclips.pl); Caddy issues and renews its Let's Encrypt
# certificate itself.
# REFCLIPS_REDIRECT_HOSTS (optional, space-separated, e.g. "www.refclips.pl 57-131-162-204.sslip.io"):
# extra addresses of the main site block. Caddy gets certificates for them and they answer with a
# permanent redirect to the main site (path and query kept, so old /s/<code> and invite links work).
# Empty or unset renders to nothing: no second block, no dummy host, no bogus certificate attempt.
{$REFCLIPS_SITE} {$REFCLIPS_REDIRECT_HOSTS} {
	# Redirect hosts (see top). 308, not 301: keeps the method and body, so a stray POST/PATCH to an old
	# address is not turned into a GET. The block's log filter below still hides tokens in these URLs.
	@other_host not host {$REFCLIPS_SITE}
	redir @other_host https://{$REFCLIPS_SITE}{uri} 308

	# Compression for text only (Caddy's default types); video (video/mp4) is already compressed and stays
	# as is: 206 (Range) responses go straight from the app.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		# Only protection against embedding in a foreign frame. Deliberately no script-src/default-src:
		# templates have inline scripts and styles (onclick, <script>, style="...").
		Content-Security-Policy "frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Referrer-Policy: pages with a token in the URL (invite /set-password/<token>, public clip link
	# /s/<code>, e-mail unsubscribe /unsubscribe/<token>) get `no-referrer` from the app. Caddy's `header`
	# overrides the app's header, so none is set here for those paths.
	@reszta not path /set-password/* /s/* /unsubscribe/*
	header @reszta Referrer-Policy "strict-origin-when-cross-origin"

	# tus upload: 50 MB chunks (52 428 800 B) in PATCH; the limit has headroom. The rest of the site is
	# forms, so the limit there is small. Caddy does not buffer requests, so 50 MB does not land in memory.
	@tus path /uploads /uploads/*
	request_body @tus {
		max_size 64MB
	}
	# Scoresheet photos/PDFs: up to 10 files of 20 MB in one form post (app/config.py SCORESHEET_*).
	@protokol path_regexp ^/matches/[0-9]+/scoresheets$
	request_body @protokol {
		max_size 220MB
	}
	@formularze {
		not path /uploads /uploads/*
		not path_regexp ^/matches/[0-9]+/scoresheets$
	}
	request_body @formularze {
		max_size 10MB
	}

	# Access log: the invite token (/set-password/<token>) allows setting another account's password and
	# the clip link code (/s/<code>) opens clips without login, a watch-room id (/watch/<id>,
	# /ws/watch/<id>) lets a logged-in user into the room and the unsubscribe token (/unsubscribe/<token>)
	# switches off someone's e-mail, so none stays in logs, in the request URL or in Referer; the rest of
	# the path stays (/s/[ukryty]/zip). Cookies and Authorization are replaced by Caddy with REDACTED anyway.
	# Location: the app redirects within /s/<code>/..., so the code is also in the response headers.
	# This filter covers the access log only; reverse_proxy warnings and this site's error log go to the
	# edge's default logger, which needs the same filter (vps-edge conf/Caddyfile, `log default`).
	# deploy/check-log-leaks.sh verifies both streams on the server.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp (/(?:set-password|s|watch|ws/watch|unsubscribe)/)[^/?#\s"]+ $1[ukryty]
			request>headers>Referer regexp (/(?:set-password|s|watch|ws/watch|unsubscribe)/)[^/?#\s"]+ $1[ukryty]
			resp_headers>Location regexp (/(?:set-password|s|watch|ws/watch|unsubscribe)/)[^/?#\s"]+ $1[ukryty]
		}
	}

	# Video (/videos, clips) is served by the app (FileResponse with Range -> 206); Caddy only passes it
	# through. flush_interval -1 = no response buffering, so seeking starts at once.
	reverse_proxy ref-clips-app:8000 {
		flush_interval -1
		transport http {
			dial_timeout 5s
		}
	}
}

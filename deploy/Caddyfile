# Caddy przed ref-clips (produkcja). Adres strony z zmiennej REFCLIPS_SITE (compose.prod.yaml),
# np. 57-131-162-204.sslip.io lub własna domena; Caddy sam wystawia i odnawia certyfikat
# Let's Encrypt (wymaga otwartych portów 80 i 443). Lokalny test: REFCLIPS_SITE=localhost
# (certyfikat z wewnętrznego CA Caddy — przeglądarka ostrzeże, curl wymaga -k).
{
	# Limity czasu na poziomie serwera. Treści żądania i odpowiedzi (read_body, write) bez limitu:
	# kawałek tus 50 MB z telefonu przez słabą sieć i film oglądany godzinę nie mogą być ucinane.
	servers {
		timeouts {
			read_header 30s
			idle 2m
		}
	}
}

{$REFCLIPS_SITE} {
	# Kompresja tylko dla tekstu (domyślne typy Caddy); wideo (video/mp4) jest już skompresowane
	# i zostaje bez zmian — odpowiedzi 206 (Range) idą wprost z aplikacji.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Tylko ochrona przed osadzaniem w cudzej ramce. Celowo bez script-src/default-src:
		# szablony mają skrypty i style w treści strony (onclick, <script>, style="...").
		Content-Security-Policy "frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Wgrywanie tus: kawałki po 50 MB (52 428 800 B) w PATCH. Limit z zapasem; reszta serwisu to
	# formularze, więc tam limit jest mały. Caddy nie buforuje żądań, więc 50 MB nie ląduje w pamięci.
	@tus path /uploads /uploads/*
	request_body @tus {
		max_size 64MB
	}
	@formularze not path /uploads /uploads/*
	request_body @formularze {
		max_size 10MB
	}

	log {
		output stdout
	}

	# Wideo (/videos, klipy) serwuje aplikacja (FileResponse z obsługą Range -> 206); Caddy tylko
	# przekazuje. flush_interval -1 = bez buforowania odpowiedzi, żeby przewijanie startowało od razu.
	reverse_proxy app:8000 {
		flush_interval -1
		transport http {
			dial_timeout 5s
		}
	}
}

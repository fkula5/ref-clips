# Caddy in front of ref-clips (production). The site address comes from REFCLIPS_SITE
# (compose.prod.yaml), e.g. 57-131-162-204.sslip.io or your own domain; Caddy issues and renews the
# Let's Encrypt certificate itself (needs ports 80 and 443 open). Local test: REFCLIPS_SITE=localhost
# (certificate from Caddy's internal CA: the browser warns, curl needs -k).
{
	# Server-level timeouts. Request and response bodies (read_body, write) have no limit: a 50 MB tus
	# chunk from a phone over a weak network and a movie watched for an hour must not be cut.
	servers {
		timeouts {
			read_header 30s
			idle 2m
		}
	}
}

{$REFCLIPS_SITE} {
	# Compression for text only (Caddy's default types); video (video/mp4) is already compressed and stays
	# as is: 206 (Range) responses go straight from the app.
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		# Only protection against embedding in a foreign frame. Deliberately no script-src/default-src:
		# templates have inline scripts and styles (onclick, <script>, style="...").
		Content-Security-Policy "frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Referrer-Policy: pages with a token in the URL (invite /set-password/<token>, public clip link
	# /s/<code>) get `no-referrer` from the app. Caddy's `header` overrides the app's header, so none is
	# set here for those paths.
	@reszta not path /set-password/* /s/*
	header @reszta Referrer-Policy "strict-origin-when-cross-origin"

	# tus upload: 50 MB chunks (52 428 800 B) in PATCH; the limit has headroom. The rest of the site is
	# forms, so the limit there is small. Caddy does not buffer requests, so 50 MB does not land in memory.
	@tus path /uploads /uploads/*
	request_body @tus {
		max_size 64MB
	}
	@formularze not path /uploads /uploads/*
	request_body @formularze {
		max_size 10MB
	}

	# Access log: the invite token (/set-password/<token>) allows setting another account's password and
	# the clip link code (/s/<code>) opens clips without login and a watch-room id (/watch/<id>,
	# /ws/watch/<id>) lets a logged-in user into the room, so none stays in logs, in the request URL or
	# in Referer; the rest of the path stays (/s/[ukryty]/zip). Cookies and Authorization are
	# replaced by Caddy with REDACTED anyway.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp (/(?:set-password|s|watch|ws/watch)/)[^/?#\s"]+ $1[ukryty]
			request>headers>Referer regexp (/(?:set-password|s|watch|ws/watch)/)[^/?#\s"]+ $1[ukryty]
		}
	}

	# Video (/videos, clips) is served by the app (FileResponse with Range -> 206); Caddy only passes it
	# through. flush_interval -1 = no response buffering, so seeking starts at once.
	reverse_proxy app:8000 {
		flush_interval -1
		transport http {
			dial_timeout 5s
		}
	}
}

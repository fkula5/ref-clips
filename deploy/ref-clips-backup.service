[Unit]
Description=Kopia zapasowa ref-clips (baza i klipy)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
# Jako root: czyta cały wolumin i zapisuje w /var/backups. Instalacja: docs/wdrozenie.md
User=root
WorkingDirectory=/opt/ref-clips
ExecStart=/opt/ref-clips/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h

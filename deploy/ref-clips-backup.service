[Unit]
Description=Kopia zapasowa ref-clips (baza i klipy)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
# Runs as root: reads the whole volume and writes to /var/backups. Install: docs/wdrozenie.md
User=root
WorkingDirectory=/opt/ref-clips
ExecStart=/opt/ref-clips/deploy/backup.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h

# Ustawienia produkcyjne ref-clips (serwer OVH). Na serwerze skopiuj do /opt/ref-clips/.env:
#   cp deploy/env.prod.example .env && chmod 600 .env
# Plik .env nie trafia do repozytorium ani nie jest nadpisywany przez deploy.sh.
# Aplikacja nie potrzebuje żadnego sekretu (klucza podpisu itp.): sesje i zaproszenia to losowe
# tokeny w bazie, hasła są hashowane argon2. Hasło administratora ustawiasz interaktywnie
# (docker compose ... run --rm app python -m app.create_admin), nie w tym pliku.
# Po zmianie: docker compose -f compose.yaml -f compose.prod.yaml up -d

# --- adres --------------------------------------------------------------------------
# Nazwa hosta, pod którą Caddy wystawia HTTPS i certyfikat Let's Encrypt (bez https://).
# Bez domeny: IP serwera zapisane z myślnikami + .sslip.io. Własna domena: patrz docs/wdrozenie.md.
REFCLIPS_SITE=57-131-162-204.sslip.io

# Adres w linkach zaproszeń (z https://, bez ukośnika na końcu); powinien odpowiadać REFCLIPS_SITE.
REFCLIPS_PUBLIC_URL=https://57-131-162-204.sslip.io

# --- za reverse proxy ---------------------------------------------------------------
# Ciasteczka tylko przez HTTPS.
REFCLIPS_COOKIE_SECURE=1
# Adres klienta (limit prób logowania) z X-Forwarded-For dopisywanego przez Caddy. Aplikacja nie
# jest publikowana na hoście, więc nagłówek pochodzi wyłącznie od Caddy.
REFCLIPS_TRUST_PROXY=1

# Porty Caddy na hoście (domyślnie 80 i 443; zmieniaj tylko do testów).
#REFCLIPS_HTTP_PORT=80
#REFCLIPS_HTTPS_PORT=443

# --- limity wgrywania (dysk 38 GB) ----------------------------------------------------
# Po systemie i obrazach Dockera zostaje ok. 28-30 GB na dane. Nagranie meczu to oryginał
# (do wyczyszczenia po konwersji) plus wersja robocza ok. 1,3 GB / 2 h, plus klipy.
# Maksymalny rozmiar jednego pliku (GB):
REFCLIPS_UPLOAD_MAX_GB=6
# Miejsce rezerwowane na wersję roboczą przy przyjmowaniu pliku (GB):
REFCLIPS_DRAFT_RESERVE_GB=1.5
# Zapas wolnego miejsca, którego wgrywanie nie zajmie (GB) — na kopie, logi i aktualizacje:
REFCLIPS_DISK_SAFETY_GB=6

# Konwersja z obniżonym priorytetem (2 vCPU: strona ma zostać responsywna).
REFCLIPS_FFMPEG_NICE=10

# Funkcje wersji 2 (ukryte). Zwykle 0.
REFCLIPS_V2_FEATURES=0

# Production settings for ref-clips. On the server copy to /opt/ref-clips/.env:
#   cp deploy/env.prod.example .env && chmod 600 .env
# .env is not committed and not overwritten by deploy.sh.
# The app needs no secret (signing key etc.): sessions and invites are random tokens in the DB,
# passwords are hashed with argon2. Set the admin password interactively (docker compose ... run --rm
# app python -m app.create_admin), not in this file.
# After changing: docker compose -f compose.yaml -f compose.prod.yaml up -d

# Host name Caddy serves HTTPS and the Let's Encrypt certificate for (no https://).
# Without a domain: the server IP written with dashes + .sslip.io. Own domain: see docs/wdrozenie.md.
REFCLIPS_SITE=57-131-162-204.sslip.io

# Address in invite links (with https://, no trailing slash); should match REFCLIPS_SITE.
REFCLIPS_PUBLIC_URL=https://57-131-162-204.sslip.io

# Cookies over HTTPS only.
REFCLIPS_COOKIE_SECURE=1
# Client address (login attempt limit) from X-Forwarded-For appended by Caddy. The app is not published
# on the host, so the header comes only from Caddy.
REFCLIPS_TRUST_PROXY=1

# Caddy ports on the host (default 80 and 443; change only for tests).
#REFCLIPS_HTTP_PORT=80
#REFCLIPS_HTTPS_PORT=443

# Upload limits (38 GB disk): after the system and Docker images about 28-30 GB remain for data. A match
# recording is the original (cleaned up after conversion) plus a draft of about 1.3 GB per 2 h, plus
# clips.
# Maximum size of one file (GB):
REFCLIPS_UPLOAD_MAX_GB=6
# Space reserved for the draft when a file is accepted (GB):
REFCLIPS_DRAFT_RESERVE_GB=1.5
# Free-space margin that uploads will not use (GB), for backups, logs and updates:
REFCLIPS_DISK_SAFETY_GB=6

# Conversion at lowered priority (2 vCPU: the site must stay responsive).
REFCLIPS_FFMPEG_NICE=10

# A hung ffmpeg (no progress for this many seconds) is killed and the task fails; 0 = disabled.
REFCLIPS_FFMPEG_STALL_SECONDS=900

# Version 2 features (hidden). Usually 0.
REFCLIPS_V2_FEATURES=0

# Monitoring (/health). Seconds without a worker heartbeat after which /health reports an error (the
# worker renews it every 30 s):
#REFCLIPS_HEALTH_WORKER_STALE_SECONDS=180
# Below how many GB of free space /health reports an error (default: same as REFCLIPS_DISK_SAFETY_GB):
#REFCLIPS_HEALTH_DISK_MIN_GB=6

# ref-clips settings for Docker. Copy to .env (cp .env.example .env) and edit as needed. .env is not
# committed; without it the defaults apply.
# After changing: docker compose up -d (the containers are recreated).

# Port the app is reachable on at this computer: http://localhost:PORT
# Change it if 8000 is taken by another program.
REFCLIPS_PORT=8000

# Address the app listens on. 127.0.0.1 = this computer only (safe).
# 0.0.0.0 = reachable by everyone on the same network (Wi-Fi, dorm, work) over plain unencrypted HTTP.
# The app holds recordings of players, including minors: use 0.0.0.0 only deliberately and briefly (e.g.
# testing from a phone on a home network).
REFCLIPS_BIND=127.0.0.1

# Cookies with the "Secure" flag work only over HTTPS. Locally (http://localhost) this MUST be 0,
# otherwise login is impossible. Set 1 on a server behind HTTPS.
REFCLIPS_COOKIE_SECURE=0

# App address used in invite links. Empty = the browser's address (locally http://localhost:8000; such a
# link works only on this computer). On a server e.g. https://klipy.example.pl
REFCLIPS_PUBLIC_URL=

# 1 = client address (login attempt limit) taken from the X-Forwarded-For header.
# Enable only behind a trusted proxy (Caddy on the server); keep 0 locally.
REFCLIPS_TRUST_PROXY=0

# Upload limits (GB): maximum size of one file, space reserved for the draft version when a file is
# accepted, and a free-space margin that uploads will not use.
# Note: free space is measured on the Docker disk (a virtual disk with Docker Desktop).
REFCLIPS_UPLOAD_MAX_GB=8
REFCLIPS_DRAFT_RESERVE_GB=1.5
REFCLIPS_DISK_SAFETY_GB=3

# Video conversion priority (nice): 10 = does not take all the CPU from the site; 0 = unchanged.
REFCLIPS_FFMPEG_NICE=10

# A hung ffmpeg (no progress for this many seconds) is killed and the task fails; 0 = disabled.
REFCLIPS_FFMPEG_STALL_SECONDS=900

# Retention of full recordings (days until removal) is set by the admin in the app, default 30.

# 1 = hidden version 2 features (clip boundary editing, ZIP export). Usually 0.
REFCLIPS_V2_FEATURES=0

# Ustawienia ref-clips w Dockerze. Skopiuj ten plik do ".env" (cp .env.example .env) i zmień,
# co potrzeba. Plik .env nie jest wysyłany do repozytorium. Bez niego działają wartości domyślne.
# Po zmianie: docker compose up -d   (kontenery zostaną utworzone ponownie).

# Port, pod którym aplikacja jest dostępna na tym komputerze: http://localhost:PORT
# Zmień, jeśli 8000 jest zajęty przez inny program.
REFCLIPS_PORT=8000

# Na którym adresie komputera aplikacja nasłuchuje. 127.0.0.1 = tylko ten komputer (bezpieczne).
# 0.0.0.0 = dostępna dla każdego w tej samej sieci (Wi-Fi, akademik, praca) po zwykłym HTTP,
# bez szyfrowania. W aplikacji są nagrania z wizerunkiem zawodników, w tym niepełnoletnich —
# ustawiaj 0.0.0.0 tylko świadomie i krótko (np. test z telefonu w domowej sieci).
REFCLIPS_BIND=127.0.0.1

# Ciasteczka z flagą "Secure" działają tylko przez HTTPS. Lokalnie (http://localhost) MUSI być 0,
# inaczej nie da się zalogować. Na serwerze za HTTPS ustaw 1.
REFCLIPS_COOKIE_SECURE=0

# Adres aplikacji w linkach zaproszeń. Puste = adres z przeglądarki (lokalnie http://localhost:8000,
# taki link działa tylko na tym komputerze). Na serwerze np. https://klipy.example.pl
REFCLIPS_PUBLIC_URL=

# 1 = adres klienta (limit prób logowania) z nagłówka X-Forwarded-For.
# Włączaj tylko za zaufanym proxy (Caddy na serwerze); lokalnie zostaw 0.
REFCLIPS_TRUST_PROXY=0

# Limity wgrywania (w GB): maksymalny rozmiar jednego pliku, miejsce na wersję roboczą
# rezerwowane przy przyjmowaniu pliku oraz zapas wolnego miejsca, którego upload nie zajmie.
# Uwaga: wolne miejsce liczone jest w obrębie dysku Dockera (u Docker Desktop to dysk wirtualny).
REFCLIPS_UPLOAD_MAX_GB=8
REFCLIPS_DRAFT_RESERVE_GB=1.5
REFCLIPS_DISK_SAFETY_GB=3

# Priorytet konwersji wideo (nice): 10 = nie zabiera całego procesora stronie; 0 = bez zmiany.
REFCLIPS_FFMPEG_NICE=10

# Zawieszony ffmpeg (brak postępu przez tyle sekund) jest zabijany, a zadanie kończy się błędem; 0 = wyłączone.
REFCLIPS_FFMPEG_STALL_SECONDS=900

# Retencja pełnych nagrań (dni do usunięcia) ustawia administrator w aplikacji, domyślnie 30.

# 1 = ukryte funkcje wersji 2 (korekta granic klipu, eksport ZIP). Zwykle 0.
REFCLIPS_V2_FEATURES=0
